rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ✅ NULL-SAFE: Checks if user exists BEFORE trying to read the role
    function isShelter() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'shelter';
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /adopterProfiles/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /pets/{petId} {
      allow read: if isSignedIn();
      // Only shelters can write, using the null-safe function
      allow write: if isShelter();
    }

    match /adoptionApplications/{appId} {
      // Null-safe read check
      allow read: if isSignedIn() && (
        (resource.data.adopterId != null && resource.data.adopterId == request.auth.uid) 
        || isShelter()
      );
      // Null-safe create check
      allow create: if isSignedIn() 
        && request.resource.data.adopterId != null 
        && request.auth.uid == request.resource.data.adopterId;
      allow update: if isShelter();
    }

    match /compatibilityScores/{scoreId} {
      allow read: if isSignedIn() && resource.data.adopterId == request.auth.uid;
      allow write: if false;
    }
  }
}