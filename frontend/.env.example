# Adoptly Frontend Environment Configuration Example
# Copy this file to .env.local before running 'npm run dev' or 'npm run build'

# Firebase Project Web SDK Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Supabase Storage Configuration (Pet Photo Uploads)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Emulators vs Live Firebase
VITE_USE_FIREBASE_EMULATORS=false

# Role Assignment Configuration (FR-01)
# Comma-separated list of shelter coordinator emails or shelter domain names
VITE_SHELTER_DOMAINS=shelter-domain.org,your-shelter-email@gmail.com
VITE_ADMIN_EMAILS=admin@adoptly.org

# Backend API Configuration
# Point to local Flask server during development or your deployed Render/Cloudflare/AWS URL in production
VITE_API_URL=http://127.0.0.1:8080
VITE_ML_ENDPOINT=http://127.0.0.1:8080/predict

# Optional browser-only mock mode (fallback rubric scoring if backend is offline)
VITE_USE_MOCK_ML=false

