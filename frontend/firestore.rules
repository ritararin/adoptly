
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user must be signed in with a verified email.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser()
        && request.auth.uid == uid;
    }

    // User profiles
    match /users/{uid} {
      allow read: if isOwner(uid);

      // New users can create only their own basic adopter profile.
      // Privileged roles must be assigned through trusted backend logic.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'createdAt',
          'emailVerified'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'adopter'
        && request.resource.data.emailVerified == true;

      // Users cannot change their own role, email, or verification status.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['name']);

      // Prevent users from deleting profiles directly.
      allow delete: if false;
    }

    // Pet listings: verified users can browse.
    // Client-side writes are disabled until shelter ownership
    // and admin approval rules are implemented.
    match /pets/{petId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if false;
    }

    // Deny access to all other collections unless explicitly allowed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
